# =====================================================================================
# Dark plasmidome annotation pipeline
#
# Specification: PLASMID_ANALYSIS.md. The pipeline implements Layer A (annotation) and
# Layer B (dark-protein characterization). Layer C, experimental prioritization, is
# deliberately NOT here: spec section 76 says the core pipeline produces no top_1000, no
# candidate_score, no novelty_score and no experimental_rank, and section 31 says that
# separation is a fundamental project requirement.
#
# S0  analysis set                     which plasmids are in scope
# S1  gene calling                     with circular-origin repair
# S2  dereplication                    exact identity, lossless
# S2b artefact screen                  AntiFam + low complexity, flag never discard
# S2c positive control                 reviewed Swiss-Prot proteins spiked into the query
# S3  annotation cascade               T1..Tn, self-narrowing on narrow_at
# S4  plasmid annotation, labels        the primary deliverable
# S5  quality gate                     positive and negative controls (run-halting)
# S6  dark set and families            MMseqs2 deep-homology clustering
# S7  evolutionary evidence            CDS recovery, codon alignments, dN/dS, RNAcode
# S8  context and structure            DefenseFinder, IntegronFinder, directons, Foldseek
#
# Design and rationale: plans/2026-09-10-pipeline-v2-design.md
# Search statistics:    docs/annotation_statistics.md
# Code walkthrough:     docs/PIPELINE_CODE.md
#
# Run:  snakemake -j <cores> --use-conda
# Plan: snakemake -n
# =====================================================================================
import sys
import yaml
from snakemake.utils import validate

configfile: "config/config.yaml"
validate(config, "../config/schemas/config.schema.yaml")

# Overridable so a smaller run - the 100-plasmid test set, a benchmark - can supply its
# own thresholds without editing the production file. hmmer_z in particular MUST match
# the analysis set: a stale -Z rescales every E-value in the run.
cascade = yaml.safe_load(open(config.get("cascade_config", "config/cascade.yaml")))
validate(cascade, "../config/schemas/cascade.schema.yaml")

targets = yaml.safe_load(open(config.get("targets_config", "config/targets.yaml")))
validate(targets, "../config/schemas/targets.schema.yaml")

# The schema checks each threshold's shape and range. It cannot check the relationships
# BETWEEN thresholds - that narrow_at must not be stricter than min_explained, for
# instance - so validate those here, at load time, before any job is scheduled.
sys.path.insert(0, "src")
from plasmidann.cascade import check_thresholds  # noqa: E402
from plasmidann.shards import discover_shards  # noqa: E402
check_thresholds(cascade)
# clustering.primary must name a resolution that exists, or every downstream stage reads a
# family set that was never built - and it would present as an empty join rather than as a
# configuration error.
_clu = targets["clustering"]
if _clu["primary"] not in _clu["resolutions"]:
    raise ValueError(
        f"clustering.primary is {_clu['primary']!r} but the configured resolutions are "
        f"{sorted(_clu['resolutions'])}. The primary resolution is the one every later "
        "stage reads, so naming one that is not built empties them all.")
OUT = config["outdir"]

# The plasmid shards are PREPARED OUTSIDE THE PIPELINE and discovered here. See
# src/plasmidann/shards.py: the pipeline used to deal the whole collection round-robin into
# a configured number of files, which meant the count was load-bearing and a new batch of
# plasmids required re-partitioning everything. Discovery makes adding a batch one more
# file: the per-shard stages run for it alone, and only the aggregating stages re-run.
SHARD_PATHS = discover_shards(config["input"]["shard_dir"])
SHARDS = list(SHARD_PATHS)

# A SEPARATE partition, over unique proteins rather than plasmids, and one the pipeline
# must still create itself: the dereplicated protein set does not exist until S2 has run,
# so there is nothing on disk to discover at workflow load time.
CASCADE_SHARDS = [f"{i:03d}" for i in range(config["shards"]["protein"])]


rule all:
    """The whole project: every annotation the run can produce.

    The deliverable is COMPLETE ANNOTATION. Spec section 76 draws the boundary: the core
    pipeline ends with a complete, evidence-rich representation of the plasmid protein
    universe and its dark subset, and it produces no top_1000, no candidate_score, no
    novelty_score and no experimental_rank. Selecting proteins to test is a separate
    downstream workflow that consumes these tables.

    Spec section 80: the annotation pipeline should not decide which unknown proteins are
    interesting. It should build the most complete and defensible representation possible
    of what is known, unknown, recurrent, conserved, contextualized and structurally
    interpretable about every plasmid ORF.
    """
    input:
        f"{OUT}/final/annotation_complete.csv",     # every ORF, every annotation
        f"{OUT}/final/dark_families_complete.csv",  # every dark family, every evidence
        f"{OUT}/s6/protein_families.tsv",           # Stage 5: every protein family
        f"{OUT}/s6/plasmid_lineage.tsv",            # Stage 6: independent lineages
        f"{OUT}/s7/recurrence.tsv",                 # Stage 7: distribution counts
        f"{OUT}/s9/synteny.tsv",                    # Stage 9: context conservation
        f"{OUT}/s4/plasmid_annotation.gff3",        # S4 feature files
        f"{OUT}/s4/plasmid_annotation.gbk",
        f"{OUT}/s5/quality_gate.txt",               # S5 the run-halting control


rule annotate_only:
    """Stop after the annotated plasmidome, without building the target list."""
    input:
        f"{OUT}/s4/plasmid_annotation.tsv",
        f"{OUT}/s2b/artefact_flags.tsv",


include: "rules/common.smk"
include: "rules/s3_cascade.smk"
include: "rules/s5_s9_targets.smk"


rule analysis_set:
    """S0: plasmids that survive the locked artifact exclusion."""
    input:
        config["input"]["master_table"],
    output:
        f"{OUT}/s0/analysis_set.txt",
    params:
        exclude=config["input"]["exclude_hab_top"],
    resources:
        mem_mb=4000,
        runtime=30,
    log:
        f"{OUT}/logs/analysis_set.log",
    conda:
        "envs/plasmidann.yaml"
    script:
        "scripts/analysis_set.py"


rule orf_call:
    """S1: call ORFs, repairing genes broken by linearising circular plasmids.

    The master table is an input because topology decides which records get origin repair.
    There is deliberately no FASTA output: v1 declared one, never wrote to it, and the
    0-byte files went unnoticed because nothing downstream read them. Protein sequence
    travels in the seq column of the TSV.
    """
    input:
        fasta=lambda wc: SHARD_PATHS[wc.shard],
        master=config["input"]["master_table"],
    output:
        tsv=f"{OUT}/s1/orfs/{{shard}}.tsv",
    params:
        min_orf_aa=config["orf"]["min_call_length_aa"],
    conda:
        "envs/plasmidann.yaml"
    resources:
        mem_mb=4000,
        runtime=120,
    log:
        f"{OUT}/logs/orf_call/{{shard}}.log",
    script:
        "scripts/orf_call.py"


rule orf_index:
    """S1: assign orf_id once, over the complete ORF set. Never recomputed downstream."""
    input:
        expand(f"{OUT}/s1/orfs/{{shard}}.tsv", shard=SHARDS),
    output:
        f"{OUT}/s1/orf_index.tsv",
    resources:
        mem_mb=24000,
        runtime=240,
    log:
        f"{OUT}/logs/orf_index.log",
    conda:
        "envs/plasmidann.yaml"
    script:
        "scripts/orf_index.py"


rule dereplicate:
    """S2: exact-identity collapse. Lossless: asserted in the script, not assumed."""
    input:
        index=f"{OUT}/s1/orf_index.tsv",
    output:
        faa=f"{OUT}/s2/unique_proteins.faa",
        map=f"{OUT}/s2/protein_map.tsv",
    resources:
        mem_mb=24000,
        runtime=240,
    log:
        f"{OUT}/logs/dereplicate.log",
    conda:
        "envs/plasmidann.yaml"
    script:
        "scripts/dereplicate.py"


rule prepare_control:
    """S2c: build the spike-in positive control and the cascade's actual query set.

    Controls are reviewed Swiss-Prot proteins of known function, independent of anything
    this pipeline computed. They travel through every tier exactly as a real protein does,
    so the gate at S5 tests the real code path - narrowing, sharding, thresholds and all.
    """
    input:
        faa=f"{OUT}/s2/unique_proteins.faa",
        raw=targets["quality_gate"]["control_fasta"].replace(
            "positive_control.faa", "raw.faa"),
    output:
        control=targets["quality_gate"]["control_fasta"],
        spiked=f"{OUT}/s2/cascade_input.faa",
    params:
        n_controls=config["controls"]["positive"]["n"],
        min_controls=targets["quality_gate"]["min_controls"],
        seed=config["seed"],
    resources:
        mem_mb=8000,
        runtime=30,
    log:
        f"{OUT}/logs/s2/prepare_control.log",
    conda:
        "envs/plasmidann.yaml"
    script:
        "scripts/prepare_control.py"


rule artefact_screen:
    """S2b: flag sequences that are probably not proteins at all.

    A shadow ORF passes every cascade tier cleanly - nothing named it, because it is not a
    protein - so it lands in the dark set with a perfect record. This stage is what stops
    that, at S5, where a flagged protein becomes target-ineligible.

    It does NOT reduce cascade compute, and an earlier docstring claimed it did. The
    cascade's query set is built by prepare_control from unique_proteins.faa and has no
    dependency on these flags, so every flagged sequence is still searched through all four
    tiers including nr. That is the deliberate consequence of P5, flag-never-discard: the
    flags stay reversible and countable, and nothing is removed from the searched set.
    """
    input:
        faa=f"{OUT}/s2/unique_proteins.faa",
        preflight=f"{OUT}/s3/preflight.tsv",
    output:
        f"{OUT}/s2b/artefact_flags.tsv",
    params:
        artefact=cascade["artefact_screen"],
        hmmer_z=cascade["hmmer_z"],
    threads: 16
    conda:
        "envs/plasmidann.yaml"
    resources:
        mem_mb=16000,
        runtime=480,
    log:
        f"{OUT}/logs/s2b/artefact_screen.log",
    script:
        "scripts/artefact_screen.py"
