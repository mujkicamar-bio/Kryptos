# =====================================================================================
# Dark plasmidome annotation pipeline
#
# Annotates every protein of every plasmid in scope and records the evidence for every
# dark protein family. It ranks and selects nothing: candidates for experiments are chosen
# by hand from the report tables.
#
# S0  analysis set                     which plasmids are in scope
# S1  gene calling                     with circular-origin repair
# S2  dereplication                    exact identity, lossless
# S2b artefact screen                  AntiFam + low complexity; AntiFam skips the tiers,
#                                      low complexity the DIAMOND tiers
# S3  annotation cascade               T1..Tn, self-narrowing on narrow_at
# S4  plasmid annotation, labels        the primary deliverable
# S5  target eligibility              unnamed, searched, not artefact-flagged
# S6  dark set and families            MMseqs2 deep-homology clustering
# S7  evolutionary evidence            CDS recovery, codon alignments, dN/dS, RNAcode
# S4d plasmid label databases          TADB, BacMet, oriTDB, CARD, mobileOG-db, dbAPIS,
#                                      Anti-CRISPRdb (DIAMOND), AMRFinderPlus
# S8  context and structure            DefenseFinder, CONJScan, IntegronFinder, ISEScan,
#                                      directons, context terms, dark family
#                                      co-occurrence, Foldseek
#
# Search statistics:    docs/annotation_statistics.md
# Code walkthrough:     docs/PIPELINE_CODE.md
#
# Run:  envs/plasmidann/bin/snakemake -s workflow/Snakefile -c <cores>
# Plan: add -n   (a core count is required: tier threads are workflow.cores)
# =====================================================================================
import sys
import yaml
from snakemake.utils import validate

configfile: "config/config.yaml"
validate(config, "../config/schemas/config.schema.yaml")

# Overridable so a smaller run - the 100-plasmid test set, a benchmark - can supply its
# own thresholds without editing the production file. hmmer_z in particular MUST match
# the analysis set: a stale -Z rescales every E-value in the run.
cascade = yaml.safe_load(open(config.get("cascade_config", "config/cascade.yaml")))
validate(cascade, "../config/schemas/cascade.schema.yaml")

targets = yaml.safe_load(open(config.get("targets_config", "config/targets.yaml")))
validate(targets, "../config/schemas/targets.schema.yaml")

# The schema checks each threshold's shape and range. It cannot check the relationships
# BETWEEN thresholds - that narrow_at must not be stricter than min_coverage, for
# instance - so validate those here, at load time, before any job is scheduled.
sys.path.insert(0, "src")
from plasmidann.cascade import check_thresholds  # noqa: E402
check_thresholds(cascade)
# clustering.primary must name a resolution that exists, or every downstream stage reads a
# family set that was never built - and it would present as an empty join rather than as a
# configuration error.
_clu = targets["clustering"]
if _clu["primary"] not in _clu["resolutions"]:
    raise ValueError(
        f"clustering.primary is {_clu['primary']!r} but the configured resolutions are "
        f"{sorted(_clu['resolutions'])}. The primary resolution is the one every later "
        "stage reads, so naming one that is not built empties them all.")
if targets["network"]["node_resolution"] not in _clu["resolutions"]:
    raise ValueError(
        f"network.node_resolution is {targets['network']['node_resolution']!r} but the "
        f"configured resolutions are {sorted(_clu['resolutions'])}.")
# Synteny reads one cluster file per level. The family table reads the primary-level rows,
# and the ORF table the close-level rows with the close cluster file (annotation_report).
_syn = targets["synteny"]["levels"]
if not set(_syn) <= set(_clu["resolutions"]) or not {_clu["primary"], "close"} <= set(_syn):
    raise ValueError(
        f"synteny.levels is {_syn}; every level must be a configured resolution "
        f"({sorted(_clu['resolutions'])}), and the primary resolution {_clu['primary']!r} "
        "and 'close' must be among them: the report reads the rows of both.")
OUT = config["outdir"]


rule all:
    """Every annotation the run can produce. No score, rank or candidate list: proteins
    for experiments are selected by hand from these tables."""
    input:
        f"{OUT}/15_report/annotation_complete.csv",     # every ORF, every annotation
        f"{OUT}/15_report/dark_families_complete.csv",  # every dark family, every evidence
        f"{OUT}/08_protein_labels/protein_labels.tsv",         # every tool label, per protein
        f"{OUT}/08_protein_labels/label_disagreements.tsv",    # S4d cross-source conflicts
        f"{OUT}/12_context_and_structure/family_context_terms.tsv",  # S8c context terms
        f"{OUT}/12_context_and_structure/conjugation_plasmid_class.tsv",  # S8f mobility
        f"{OUT}/12_context_and_structure/dark_cooccurrence.tsv",  # S8g dark sequences together
        f"{OUT}/10_clustering/protein_families.tsv",           # Stage 5: every protein family
        f"{OUT}/10_clustering/network_summary.tsv",            # Stage 5b: family network
        f"{OUT}/10_clustering/plasmid_lineage.tsv",            # Stage 6: independent lineages
        f"{OUT}/11_distribution_and_evolution/recurrence.tsv",                 # Stage 7: distribution counts
        f"{OUT}/13_synteny/synteny.tsv",                    # Stage 9: context conservation
        f"{OUT}/14_rarity/family_rarity.tsv",             # Stage 14: rarity labels
        f"{OUT}/15_report/dark_family_rarefaction.tsv", # Stage 14: saturation curve
        f"{OUT}/06_annotation_tables/plasmid_annotation.gff3",        # S4 feature files
        f"{OUT}/06_annotation_tables/plasmid_annotation.gbk",
        f"{OUT}/09_target_eligibility/target_eligibility.txt",   # S5 dark set counts


rule annotate_only:
    """Stop after the plasmid annotation table and the artefact flags."""
    input:
        f"{OUT}/06_annotation_tables/plasmid_annotation.tsv",
        f"{OUT}/04_orf_qc/artefact_flags.tsv",


include: "rules/common.smk"
include: "rules/annotation_cascade.smk"
include: "rules/evidence.smk"


rule analysis_set:
    """S0: plasmids that survive the locked artifact exclusion, as ids and as sequence.

    The FASTA written here is what every sequence-reading stage takes. The configured
    input may hold more than the analysis set - the working set carries the simulated
    plasmids the exclusion removes - so scope is applied once, here, and never again.
    """
    input:
        master=config["input"]["master_table"],
        fasta=config["input"]["fasta"],
    output:
        ids=f"{OUT}/01_analysis_set/analysis_set.txt",
        fasta=f"{OUT}/01_analysis_set/analysis_set.fna",
        # The plasmids below the size cut-off: what "small plasmid" means downstream.
        small_ids=f"{OUT}/01_analysis_set/small_plasmids.txt",
        # Circular records whose ends repeated, and how many bases S0 trimmed.
        repeats=f"{OUT}/01_analysis_set/terminal_repeats.tsv",
        # The length of every written record, after that removal: gene coordinates refer
        # to it, and size_bp in the master table does not.
        lengths=f"{OUT}/01_analysis_set/plasmid_lengths.tsv",
    params:
        exclude=config["input"]["exclude_hab_top"],
        max_size_bp=config["input"]["max_plasmid_size_bp"],
        min_terminal_repeat_bp=config["orf"]["min_terminal_repeat_bp"],
    resources:
        mem_mb=4000,
        runtime=60,
    benchmark:
        f"{OUT}/benchmarks/analysis_set.tsv"
    log:
        f"{OUT}/logs/analysis_set.log",
    conda:
        "envs/plasmidann.yaml"
    script:
        "scripts/analysis_set.py"


rule orf_call:
    """S1: call ORFs, repairing genes broken by linearising circular plasmids.

    The master table is an input because topology decides which records get origin repair.
    Protein sequence travels in the seq column of the TSV; there is no FASTA output.
    """
    input:
        fasta=f"{OUT}/01_analysis_set/analysis_set.fna",
        master=config["input"]["master_table"],
    output:
        tsv=f"{OUT}/02_orf_calling/orfs.tsv",
    params:
        min_orf_aa=config["orf"]["min_call_length_aa"],
    # Pyrodigal is single-threaded and calls each plasmid alone (meta mode), so the script
    # spreads the records over a process pool of this size.
    threads: workflow.cores
    conda:
        "envs/plasmidann.yaml"
    resources:
        mem_mb=32000,
        runtime=720,
    benchmark:
        f"{OUT}/benchmarks/orf_call.tsv"
    log:
        f"{OUT}/logs/orf_call.log",
    script:
        "scripts/orf_call.py"


rule orf_index:
    """S1: assign orf_id once, over the complete ORF set. Never recomputed downstream."""
    input:
        f"{OUT}/02_orf_calling/orfs.tsv",
    output:
        f"{OUT}/02_orf_calling/orf_index.tsv",
    resources:
        mem_mb=24000,
        runtime=240,
    benchmark:
        f"{OUT}/benchmarks/orf_index.tsv"
    log:
        f"{OUT}/logs/orf_index.log",
    conda:
        "envs/plasmidann.yaml"
    script:
        "scripts/orf_index.py"


rule dereplicate:
    """S2: exact-identity collapse. Lossless: asserted in the script, not assumed."""
    input:
        index=f"{OUT}/02_orf_calling/orf_index.tsv",
    output:
        faa=f"{OUT}/03_dereplication/unique_proteins.faa",
        map=f"{OUT}/03_dereplication/protein_map.tsv",
    resources:
        mem_mb=24000,
        runtime=240,
    benchmark:
        f"{OUT}/benchmarks/dereplicate.tsv"
    log:
        f"{OUT}/logs/dereplicate.log",
    conda:
        "envs/plasmidann.yaml"
    script:
        "scripts/dereplicate.py"


rule plasmidscope_import:
    """S2p: PlasmidScope's published eggNOG result for every protein of ours it contains.

    Proteins it annotates skip the cascade (cascade_selection) and enter
    protein_annotation.tsv as tier PS (cascade_resolve); their orthology terms come from
    here too (orthology). Joined on identical sequence only. See plasmidann.plasmidscope.
    """
    input:
        faa=f"{OUT}/03_dereplication/unique_proteins.faa",
        ps=config["input"]["plasmidscope_proteins"],
    output:
        f"{OUT}/03_dereplication/plasmidscope_proteins.tsv",
    resources:
        mem_mb=16000,
        runtime=120,
    benchmark:
        f"{OUT}/benchmarks/plasmidscope_import.tsv"
    log:
        f"{OUT}/logs/03_dereplication/plasmidscope_import.log",
    conda:
        "envs/plasmidann.yaml"
    script:
        "scripts/plasmidscope_import.py"


rule protein_clustering:
    """Every unique protein into families at three resolutions, before annotation.

    A family is a sequence cluster, so it needs only sequence and is made first: rule
    cascade_selection reads the primary resolution, rule protein_families reads all three
    after the cascade. Every protein is clustered, so no member is lost to an earlier filter.
    """
    input:
        faa=f"{OUT}/03_dereplication/unique_proteins.faa",
    output:
        reps=expand(f"{OUT}/10_clustering/families_{{res}}_rep_seq.fasta",
                    res=targets["clustering"]["resolutions"]),
        clusters=expand(f"{OUT}/10_clustering/families_{{res}}_cluster.tsv",
                        res=targets["clustering"]["resolutions"]),
    params:
        clustering=targets["clustering"],
    threads: 32
    resources:
        mem_mb=128000,
        runtime=720,
    benchmark:
        f"{OUT}/benchmarks/protein_clustering.tsv"
    log:
        f"{OUT}/logs/10_clustering/protein_clustering.log",
    conda:
        "envs/plasmidann.yaml"
    script:
        "scripts/protein_clustering.py"


rule cascade_selection:
    """Which proteins the cascade annotates, and which of those it searches.

    Selected: neither annotated by Tier 0 nor flagged by AntiFam, in a family (primary)
    holding a small-plasmid protein that is neither. Searched: the representatives of a 90%
    clustering of the selected proteins; the members take their representative's result at
    cascade_resolve. AntiFam-flagged proteins skip every tier (role artefact_antifam).
    """
    input:
        faa=f"{OUT}/03_dereplication/unique_proteins.faa",
        map=f"{OUT}/03_dereplication/protein_map.tsv",
        small_ids=f"{OUT}/01_analysis_set/small_plasmids.txt",
        ps=f"{OUT}/03_dereplication/plasmidscope_proteins.tsv",
        families=f"{OUT}/10_clustering/families_{targets['clustering']['primary']}_cluster.tsv",
        # AntiFam-flagged proteins are never searched.
        artefact=f"{OUT}/04_orf_qc/artefact_flags.tsv",
    output:
        tsv=f"{OUT}/03_dereplication/selection.tsv",
        faa=f"{OUT}/03_dereplication/search_representatives.faa",
    params:
        search=cascade["search_clustering"],
    threads: 32
    resources:
        mem_mb=64000,
        runtime=240,
    benchmark:
        f"{OUT}/benchmarks/cascade_selection.tsv"
    log:
        f"{OUT}/logs/03_dereplication/cascade_selection.log",
    conda:
        "envs/plasmidann.yaml"
    script:
        "scripts/cascade_selection.py"


rule artefact_screen:
    """S2b: flag sequences that are probably not proteins at all.

    A shadow ORF passes every cascade tier cleanly - nothing named it, because it is not a
    protein - so it would reach the dark set with a perfect record. Rule target_eligibility (S5)
    marks a flagged protein as not target-eligible, so it does not enter the dark set.

    An AntiFam flag also skips every annotation tier (user decision, 2026-09-25):
    cascade_selection gives the protein role artefact_antifam, so it is in no tier's query
    set, and cascade_resolve writes it as NOT_SEARCHED with annot_source artefact_antifam.
    A low-complexity flag skips the DIAMOND tiers only (tier_search). No sequence is removed from any table: the flagged
    protein keeps its row and its flag, and the skip is countable from both.
    """
    input:
        faa=f"{OUT}/03_dereplication/unique_proteins.faa",
        preflight=f"{OUT}/05_annotation_cascade/preflight.tsv",
        # The screen searches with -Z, so it waits for -Z to be confirmed.
        hmmer_z=f"{OUT}/03_dereplication/hmmer_z_checked.tsv",
    output:
        f"{OUT}/04_orf_qc/artefact_flags.tsv",
    params:
        artefact=cascade["artefact_screen"],
        hmmer_z=cascade["hmmer_z"],
    threads: 16
    conda:
        "envs/plasmidann.yaml"
    resources:
        mem_mb=16000,
        runtime=480,
    benchmark:
        f"{OUT}/benchmarks/artefact_screen.tsv"
    log:
        f"{OUT}/logs/04_orf_qc/artefact_screen.log",
    script:
        "scripts/artefact_screen.py"
