# ---- Large data trees: regenerable or too big for git ----
# Root-anchored, so that workflow/envs/ (the environment specifications) is not matched.
/data/
/envs/

# ---- tools/: our own scripts are tracked, anything else placed there is not ----
tools/*
!tools/*.py
!tools/*.sh

# ---- Python / Jupyter cruft ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ---- Scratch ----
*.tmp
*.swp
slurm-*.out

# ---- Pipeline ----
.venv/
# Tool caches (XDG_CACHE_HOME in workflow/run_pipeline.sbatch).
/.cache/
results*/
.snakemake/

# ---- Agent skills and their working state ----
.claude/skills/
.unlazy/
.unlazy-hook-state.json
graphify-out/
